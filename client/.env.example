# =====================================================================
# Dipakai oleh backend (api/_app.js) saat development lokal (npm run api:dev)
# =====================================================================

# Isi dari Neon dashboard > Connection string (mode "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Ganti dengan string acak panjang (untuk menandatangani JWT)
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak

# Opsional, jika mengaktifkan Login Google
GOOGLE_CLIENT_ID=

# Origin frontend yang diizinkan (CORS) - untuk dev lokal saja,
# di produksi tidak dipakai karena frontend & API satu domain.
CLIENT_ORIGIN=http://localhost:5173

# =====================================================================
# Dipakai oleh frontend (Vite) - opsional
# =====================================================================
# Default-nya frontend memanggil /api (satu domain). Isi ini HANYA jika
# API di-host di domain terpisah dari frontend.
# VITE_API_URL=https://contoh-domain-lain.com/api
